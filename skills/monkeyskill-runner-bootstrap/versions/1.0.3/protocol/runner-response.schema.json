{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allenyllee.github.io/monkeyskill-store/protocol/runner-response.schema.json",
  "title": "MonkeySkill Runner response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "runner", "summary", "results", "evidence"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string" },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactHash", "provider", "protocolVersion"],
      "properties": {
        "artifactHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
        "protocolVersion": { "const": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "fail", "inconclusive"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "inconclusive": { "type": "integer", "minimum": 0 }
      }
    },
    "results": { "type": "array", "maxItems": 200 },
    "evidence": { "type": "array", "maxItems": 400 }
  }
}
