{
  "schemaVersion": 1,
  "workflow": "generate-validate-install-runner",
  "maximumBuildAttempts": 8,
  "roles": {
    "orchestrator": {
      "reads": ["bootstrap.json", "skill.json", "SKILL.md", "workflow.json", "protocol/runner-request.schema.json", "protocol/runner-response.schema.json", "protocol/active-runner.schema.json", "conformance/meta-conformance.json"],
      "responsibilities": ["verify-package-hashes", "discover-environment", "enforce-role-isolation", "validate-evidence", "atomic-install", "run-host-integration", "handoff-to-invoking-orchestrator"]
    },
    "builder": {
      "fresh": true,
      "reads": ["skill.json", "SKILL.md", "protocol/runner-request.schema.json", "protocol/runner-response.schema.json", "protocol/active-runner.schema.json"],
      "mustNotRead": ["conformance/meta-conformance.json", "tester-reasoning", "prior-runner-source"],
      "returns": ["complete-source-tree", "launch-manifest", "implementation-notes"]
    },
    "tester": {
      "fresh": true,
      "reads": ["skill.json", "SKILL.md", "protocol/runner-request.schema.json", "protocol/runner-response.schema.json", "protocol/active-runner.schema.json", "conformance/meta-conformance.json", "generated-artifact"],
      "mustNotRead": ["builder-reasoning"],
      "returns": ["structured-meta-conformance-evidence", "artifact-hash", "constrained-diagnostics"]
    }
  },
  "phases": [
    "verify-versioned-package",
    "discover-current-environment",
    "fresh-builder-generates-runner",
    "fresh-tester-runs-positive-and-negative-meta-conformance",
    "repair-from-constrained-diagnostics",
    "atomically-install-passing-artifact",
    "configure-authenticated-monkeyskill-host",
    "prove-generated-artifact-hash-at-runtime",
    "handoff-generic-runner-evidence-to-invoking-orchestrator",
    "report-evidence-and-rollback"
  ],
  "success": {
    "required": ["all-package-hashes-match", "all-meta-conformance-required-cases-pass", "negative-canaries-fail-closed", "installed-hash-equals-tested-hash", "host-reports-installed-runner-hash", "generic-orchestrator-handoff-ready"],
    "failClosedOn": ["missing-capability", "schema-error", "unsupported-test", "adapter-compilation-failure", "timeout", "inconclusive-required-observation", "hash-mismatch", "privilege-expansion", "external-network-attempt"]
  }
}
